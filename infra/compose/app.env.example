# Дополнительные настройки API и воркеров (необязательно). Скопируйте в infra/compose/app.env.
# Все параметры — в services/api/src/doomich_api/config.py (переменные с префиксом DOOMICH_).

# ссылка «Скачать приложение» на публичной странице приглашения
# DOOMICH_DOWNLOADS_URL=https://doomich.example.ru/download/

# серверы расписания во внутренней сети вуза, которые можно опрашивать (JSON-список)
# DOOMICH_SCHEDULE_SOURCE_PRIVATE_HOSTS=["rasp.intranet.example.ru","10.20.0.15"]

# размерность эмбеддингов должна совпадать с моделью (Qwen3-Embedding-0.6B — 1024)
# DOOMICH_EMBEDDING_DIM=1024

# ограничения
# DOOMICH_MAX_UPLOAD_MB=20
# DOOMICH_MAX_LECTURE_MB=500
# DOOMICH_MESSAGES_PER_DAY_LIMIT=300
# DOOMICH_DEFAULT_HISTORY_DAYS=90

# антивирусная проверка загрузок (контейнер clamav в той же сети)
# DOOMICH_CLAMAV_HOST=clamav
