# Модели речи (необязательно; без файла работают демо-движки). Скопируйте в infra/compose/speech.env.
# Модели скачиваются в том models (/models), как — см. docs/dev/deploy.md, раздел «Модели речи».

# Распознавание: GigaAM-v3 для русского (sherpa-onnx), Whisper large-v3-turbo для английского (faster-whisper)
DOOMICH_ASR_ENGINES=[{"kind": "gigaam", "model_dir": "/models/gigaam-v3-ctc", "model_type": "ctc", "threads": 4, "languages": ["ru"]}, {"kind": "whisper", "model": "large-v3-turbo", "device": "cuda", "compute_type": "float16", "languages": ["en"]}]

# Синтез: модели sherpa-onnx (VITS и др.); выбор голосов — по итогам бенчмарка (docs/05-architecture-and-stack.md)
DOOMICH_TTS_ENGINES={"ru": {"kind": "sherpa", "model_dir": "/models/tts-ru", "model_type": "vits"}, "en": {"kind": "sherpa", "model_dir": "/models/tts-en", "model_type": "vits"}}
DOOMICH_TTS_VOICES=[{"id": "ru-default", "engine": "ru", "language": "ru", "speaker": 0, "title": "Думыч"}, {"id": "en-default", "engine": "en", "language": "en", "speaker": 0, "title": "Doomich"}]
