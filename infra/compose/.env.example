# Боевые настройки «Думыча» для docker compose. Скопируйте в infra/compose/.env (файл не попадает в git):
#   cp infra/compose/.env.example infra/compose/.env && infra/scripts/gen-secrets.sh >> infra/compose/.env
# Эти значения только подставляются в compose-файлы; в контейнер API попадают лишь нужные ему.

# --- адрес и версия ---
DOOMICH_ENV=prod
DOOMICH_PUBLIC_BASE_URL=https://doomich.example.ru
DOOMICH_SERVER_NAME=doomich.example.ru
# образы: собранные локально (doomich) или из своего реестра, например registry.example.ru/doomich
DOOMICH_REGISTRY=doomich
DOOMICH_VERSION=latest

# --- секреты: сгенерируйте infra/scripts/gen-secrets.sh, храните копию отдельно (без мастер-ключа данные не расшифровать) ---
POSTGRES_PASSWORD=
DOOMICH_DB_PASSWORD=
DOOMICH_JWT_SECRET=
DOOMICH_MASTER_KEY=
DOOMICH_INVITE_PEPPER=
GRAFANA_ADMIN_PASSWORD=

# --- HTTPS: каталог с fullchain.pem и privkey.pem (Let's Encrypt или сертификат вуза) ---
DOOMICH_TLS_DIR=./certs
# свой список адресов для панели администратора (подсеть VPN), по умолчанию — infra/nginx/doomich/admin-allow.conf
# DOOMICH_ADMIN_ALLOW_FILE=./admin-allow.conf

# --- модели (compose.gpu.yaml); имена — репозитории Hugging Face, выбор и память — docs/06-server-requirements.md ---
# Конфигурация А (1× RTX 4090 24 ГБ) — модель до ~9B в FP8; конфигурация Б — Qwen3.6-35B-A3B в 4 бит (AWQ/GPTQ).
# Проверьте точное имя репозитория и лицензию на huggingface.co перед запуском.
LLM_MODEL_ID=Qwen/Qwen3.5-9B
LLM_MAX_MODEL_LEN=32768
# доля памяти карты под LLM: на одной карте с речью и эмбеддингами — 0.6, на отдельной карте — 0.88
LLM_GPU_MEMORY=0.6
LLM_TOOL_PARSER=hermes
EMBEDDINGS_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
RERANKER_MODEL_ID=Qwen/Qwen3-Reranker-0.6B
# номера видеокарт: на одной карте — 0 и 0, на двух — 0 (LLM) и 1 (речь, эмбеддинги, реранкер)
LLM_GPU=0
SPEECH_GPU=0
# доступ к закрытым моделям Hugging Face, если нужен
HF_TOKEN=

# --- производительность ---
DOOMICH_API_WORKERS=2
DOOMICH_WORKER_CONCURRENCY=4
