# Сформировано Ansible ({{ ansible_date_time.date }}). Не редактируйте на сервере — меняйте group_vars и vault.
DOOMICH_ENV=prod
DOOMICH_PUBLIC_BASE_URL={{ doomich_public_base_url }}
DOOMICH_SERVER_NAME={{ doomich_server_name }}
DOOMICH_VERSION={{ doomich_version | regex_replace('[^A-Za-z0-9_.-]', '-') }}
POSTGRES_PASSWORD={{ vault_postgres_password }}
DOOMICH_DB_PASSWORD={{ vault_db_password }}
DOOMICH_JWT_SECRET={{ vault_jwt_secret }}
DOOMICH_MASTER_KEY={{ vault_master_key }}
DOOMICH_INVITE_PEPPER={{ vault_invite_pepper }}
GRAFANA_ADMIN_PASSWORD={{ vault_grafana_password }}
DOOMICH_TLS_DIR=./certs
DOOMICH_ADMIN_ALLOW_FILE=./admin-allow.conf
LLM_MODEL_ID={{ doomich_llm_model_id }}
LLM_GPU={{ doomich_llm_gpu }}
LLM_GPU_MEMORY={{ doomich_llm_gpu_memory }}
SPEECH_GPU={{ doomich_speech_gpu }}
HF_TOKEN={{ vault_hf_token | default('') }}
